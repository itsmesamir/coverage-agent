# Copy to .env and fill in. .env is gitignored and is the only place
# credentials and model names live.
#
# SQLAlchemy-style driver prefixes are not used here; postgres.js takes a plain URL.
# Docker compose services:  postgresql://coverage:coverage@localhost:5433/coverage_agent
DATABASE_URL=
REDIS_URL=redis://localhost:6380/0

# --- Agent: needs reliable structured tool calling -------------------------
#
# The Gemini free tier meters requests per project, per model, per day (~20),
# so the daily budget is a product: keys x models. Both fields accept a comma
# separated list, best first. The pool stays on the first member until its
# daily quota is genuinely gone, then falls to the next -- so order the models
# by quality, not by cost.
#
# Floating aliases (*-latest) go LAST. They have their own quota bucket, so
# they are real extra budget, but the model behind them changes without
# notice -- which would silently invalidate an eval baseline. Overflow only.
AGENT_PROVIDER=gemini
AGENT_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest
GEMINI_API_KEYS=

# --- Simulation: carrier personas and the claim extractor ------------------
#
# Cheap, high volume, no tool calling. Groq's free limits are far higher than
# Gemini's, which is why the noisy work lives here.
SIM_PROVIDER=groq
SIM_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_API_KEYS=

# --- Cost control ----------------------------------------------------------
#
# Cache identical LLM requests to disk so re-running an unchanged negotiation
# costs no quota. Set to "off" when measuring variance, where caching would
# hide the thing being measured.
LLM_CACHE=on
LLM_CACHE_DIR=.cache/llm
