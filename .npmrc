# Makes the package.json "engines" constraint a hard failure instead of a
# warning. Without this, `make test` from a shell that hasn't nvm-used 22
# silently runs on whatever Node is ambient and only warns -- discovered while
# closing out the TypeScript port, when `make lint`/`make test`/`make
# typecheck` all ran clean on Node 23.11 with nothing but a WARN line.
engine-strict=true
